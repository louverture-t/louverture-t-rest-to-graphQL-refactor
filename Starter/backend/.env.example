# Copy this file to .env and fill in real values before starting the server.
# NEVER commit .env — it is listed in .gitignore.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/stackeleven
# Generate a strong random secret, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_STRONG_RANDOM_SECRET
